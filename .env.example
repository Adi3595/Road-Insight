# Road Recorder API Environment Variables Example
# Copy this file to .env and configure secrets securely on your Raspberry Pi.
# NEVER commit the real .env file or production API keys to git!

# Cryptographically random API key (32+ characters recommended)
# Run `python3 -m road_recorder.api.keygen --generate` to generate a secure key.
ROAD_RECORDER_API_KEY="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY"

# Optional overrides
# ROAD_RECORDER_HOST="0.0.0.0"
# ROAD_RECORDER_PORT="8000"
